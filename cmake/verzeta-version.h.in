// Generated by CMake from cmake/verzeta-version.h.in at configure time.
// Do NOT edit the generated .h directly — your change will be overwritten
// on the next CMake configure.
//
// To bump the project version, edit the single-line VERSION file at the
// repo root. CMakeLists.txt reads it, populates PROJECT_VERSION, and this
// header re-generates on the next configure. Downstream consumers
// (backend/main.cpp's setApplicationVersion, the Windows installer's
// AppVersion, the CI workflows' version-string output) all derive from
// the same VERSION file, so a release bump is a single-line edit.

#pragma once

#define VERZETA_VERSION_STR     "@PROJECT_VERSION@"
#define VERZETA_VERSION_MAJOR   @PROJECT_VERSION_MAJOR@
#define VERZETA_VERSION_MINOR   @PROJECT_VERSION_MINOR@
#define VERZETA_VERSION_PATCH   @PROJECT_VERSION_PATCH@
